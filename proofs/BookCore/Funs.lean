        else Book.set self side { price, quantity := quantity }
    else
      let quantity ← q + delta
      if quantity < 0#i64
      then ok (core.result.Result.Err Error.NegativeQuantity, self)
      else Book.set self side { price, quantity := quantity }
  else ok (core.result.Result.Err Error.PriceOutOfRange, self)

